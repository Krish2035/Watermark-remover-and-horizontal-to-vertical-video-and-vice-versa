# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret for Cookie Authentication
JWT_SECRET=super_secret_jwt_random_key_production_2026

# Neon Tech PostgreSQL Connection String
# Get this from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Connection URL (Optional - Render Redis, Upstash, or local)
# Example: rediss://default:password@sample-redis.upstash.io:6379
REDIS_URL=redis://localhost:6379

